rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveProfile(userId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/profiles/$(userId)).data.status == 'ACTIVE';
    }

    function isOpenPeriod(userId, monthKey) {
      let period = /databases/$(database)/documents/profiles/$(userId)/timePeriods/$(monthKey);
      return !exists(period) || get(period).data.status == 'OPEN';
    }

    function isValidAdjustmentTarget(userId, timeEntryId) {
      return timeEntryId is string
        && get(/databases/$(database)/documents/timeEntries/$(timeEntryId)).data.userId == userId;
    }

    match /profiles/{userId} {
      allow create: if isCurrentUser(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if isCurrentUser(userId) || isAdmin();
      allow list: if isAdmin();

      allow update: if isAdmin()
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /timeEntries/{entryId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'recordedAt',
          'dayKey',
          'monthKey',
          'status'
        ])
        && isActiveProfile(request.resource.data.userId)
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.dayKey is string
        && request.resource.data.monthKey is string
        && (
          isAdmin()
          || (
            isCurrentUser(request.resource.data.userId)
            && request.resource.data.recordedAt == request.time
          )
        );

      allow get, list: if isCurrentUser(resource.data.userId) || isAdmin();

      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recordedAt',
          'dayKey',
          'monthKey',
          'status'
        ])
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.dayKey is string
        && request.resource.data.monthKey is string
        && request.resource.data.status in ['ACTIVE', 'REMOVED'];

      allow delete: if false;
    }

    match /timeEntryAdjustments/{adjustmentId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'requestedById',
          'type',
          'status',
          'targetTimeEntryId',
          'currentRecordedAt',
          'proposedRecordedAt',
          'dayKey',
          'monthKey',
          'requestedAt',
          'decidedAt',
          'decidedById'
        ])
        && request.resource.data.requestedById == request.auth.uid
        && (isCurrentUser(request.resource.data.userId) || isAdmin())
        && isActiveProfile(request.resource.data.userId)
        && request.resource.data.dayKey is string
        && request.resource.data.monthKey is string
        && request.resource.data.requestedAt == request.time
        && isOpenPeriod(
          request.resource.data.userId,
          request.resource.data.monthKey
        )
        && (
          (
            request.resource.data.status == 'PENDING'
            && request.resource.data.decidedAt == null
            && request.resource.data.decidedById == null
          )
          || (
            isAdmin()
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.decidedAt == request.time
            && request.resource.data.decidedById == request.auth.uid
          )
        )
        && (
          (
            request.resource.data.type == 'ADD'
            && request.resource.data.targetTimeEntryId == null
            && request.resource.data.currentRecordedAt == null
            && request.resource.data.proposedRecordedAt is timestamp
          )
          || (
            request.resource.data.type == 'CHANGE'
            && isValidAdjustmentTarget(
              request.resource.data.userId,
              request.resource.data.targetTimeEntryId
            )
            && request.resource.data.currentRecordedAt is timestamp
            && request.resource.data.proposedRecordedAt is timestamp
          )
          || (
            request.resource.data.type == 'REMOVE'
            && isValidAdjustmentTarget(
              request.resource.data.userId,
              request.resource.data.targetTimeEntryId
            )
            && request.resource.data.currentRecordedAt is timestamp
            && request.resource.data.proposedRecordedAt == null
          )
        );

      allow get, list: if isCurrentUser(resource.data.userId) || isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedById == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'decidedAt',
          'decidedById'
        ])
        && isOpenPeriod(resource.data.userId, resource.data.monthKey);

      allow delete: if false;
    }

    match /profiles/{userId}/timePeriods/{monthKey} {
      allow get, list: if isCurrentUser(userId) || isAdmin();
      allow create, update, delete: if false;
    }
  }
}
